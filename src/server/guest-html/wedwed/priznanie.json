{
  "bodyClass": "sm-template94 sm-color0 sm-scroll_type-1 sm-scroll_speed-1 sm-hfont-0 sm-project-",
  "layouts": [
    {
      "type": "COVER",
      "tag": "",
      "html": "<section {{section:attrs}} class=\"sm-main sm-shared sm-section-type-1\">{{section:tools}}\n<div class=\"sm-container\">\n<div class=\"sm-main__title\">\n<span class=\"sm-date item-animation item-atop\">\n<span class=\"sm-inline-animation\" data-wv-date=\"\">{{g:day}}</span>\n<span class=\"sm-inline-animation\" data-wv-date=\"\">{{g:monthGenitive}}</span>,\n                    <span class=\"sm-inline-animation\" data-wv-date=\"\">{{g:fullYear}}</span>\n<span class=\"timing-separator\">|</span>\n<span data-wv-date=\"\">{{g:time}}</span>\n</span>\n</div>\n<div class=\"sm-main__content sm-shared__content\">\n<div class=\"sm-main__image sm-shared__image item-animation item-atop\">\n<div class=\"sm-img\">\n<img alt=\"Фотография\" {{i:imageUrl}} loading=\"eager\" src=\"{{v:imageUrl}}\"/>\n</div>\n</div>\n<div class=\"sm-main__names\">\n<div class=\"sm-needtoresize\">\n<span class=\"sm-inline-animation item-animation item-aleft\" data-wedding-names=\"\">{{g:groom}}</span>\n<br/>\n<span class=\"sm-inline-animation item-animation item-atop\">&amp;</span>\n<span class=\"sm-inline-animation item-animation item-aright\" data-wedding-names=\"\">{{g:bride}}</span>\n</div>\n</div>\n</div>\n</div>\n</section>"
    },
    {
      "type": "CALENDAR",
      "tag": "",
      "html": "<section {{section:attrs}} class=\"sm-datetime sm-section sm-section-type-2\">{{section:tools}}\n<div class=\"sm-container sm-container-flex\">\n<div class=\"sm-section__text\">\n<h2 class=\"sm-title item-animation item-aleft\" {{a:title}}>{{v:title}}</h2>\n<div class=\"sm-text item-animation item-atop\" {{a:message}}>{{v:message}}</div>\n<p class=\"sm-calendar__date item-animation item-aright\">\n<span class=\"sm-inline-animation\" data-wv-date=\"\">{{g:day}}</span>\n<span class=\"sm-inline-animation\" data-wv-date=\"\">{{g:monthGenitive}}</span>,\n                    <span class=\"sm-inline-animation\" data-wv-date=\"\">{{g:fullYear}}</span>\n<span class=\"timing-separator\">|</span>\n<span data-wv-date=\"\">{{g:time}}</span>\n</p>\n</div>\n<div class=\"sm-calendar__wrapper\">\n<div class=\"sm-calendar__box text-paint-border item-animation item-atop\">\n<div class=\"sm-calendar__month\" data-wv-date=\"\">{{g:monthName}}</div>\n<div class=\"sm-calendar js-calendar-body\" data-class-day=\"\" data-class-name-day=\"\" data-wedding-day-class=\"sm-number-active\" data-wv-calendar='{\"dayClass\": \"sm-calendar-day\", \"activeClass\": \"sm-number-active\", \"weekClass\": \"sm-calendar-day-week-title\"}'>{{calendar:3}}</div>\n</div>\n<p class=\"sm-calendar__date sm-only-mobile item-animation item-atop\">\n<span class=\"sm-inline-animation\" data-wv-date=\"\">{{g:day}}</span>\n<span class=\"sm-inline-animation\" data-wv-date=\"\">{{g:monthGenitive}}</span>,\n                    <span class=\"sm-inline-animation\" data-wv-date=\"\">{{g:fullYear}}</span>\n<span class=\"timing-separator\">|</span>\n<span data-wv-date=\"\">{{g:time}}</span>\n</p>\n</div>\n</div>\n</section>"
    },
    {
      "type": "VENUE",
      "tag": "",
      "html": "<section {{section:attrs}} class=\"sm-location sm-section sm-section-type-1\">{{section:tools}}\n<div class=\"sm-container sm-container-flex\">\n<div class=\"sm-location__image item-animation item-aright\">\n<div class=\"sm-img\">\n<img alt=\"Фотография\" {{i:imageUrl}} loading=\"lazy\" src=\"{{v:imageUrl}}\"/>\n</div>\n</div>\n<div class=\"sm-section__text\">\n<h2 class=\"sm-title item-animation item-aleft\" {{a:title}}>{{v:title}}</h2>\n<div class=\"sm-text item-animation item-atop\" {{a:address}}>{{v:name}}\n{{v:address}}</div>\n<a class=\"sm-btn item-animation item-abottom\" data-wv-link=\"mapUrl\" href=\"{{v:mapUrl}}\" target=\"_blank\">Как добраться</a>\n</div>\n</div>\n</section>"
    },
    {
      "type": "TIMELINE",
      "tag": "",
      "html": "<section {{section:attrs}} class=\"sm-timing sm-section sm-section-type-2\">{{section:tools}}\n<div class=\"sm-container\">\n<h2 class=\"sm-title item-animation item-atop\" {{a:title}}>{{v:title}}</h2>\n<div class=\"sm-timing__items\">\n<div class=\"sm-timing__item item-animation item-aright\">\n<div class=\"sm-timing-text\">\n<div class=\"sm-timing__item__time\" {{a:items.0.time}}>{{v:items.0.time}}</div>\n<div class=\"sm-timing__item__title\" {{a:items.0.title}}>{{v:items.0.title}}</div>\n</div>\n</div>\n<div class=\"sm-timing__item item-animation item-aleft\">\n<div class=\"sm-timing-text\">\n<div class=\"sm-timing__item__time\" {{a:items.1.time}}>{{v:items.1.time}}</div>\n<div class=\"sm-timing__item__title\" {{a:items.1.title}}>{{v:items.1.title}}</div>\n</div>\n</div>\n<div class=\"sm-timing__item item-animation item-aright\">\n<div class=\"sm-timing-text\">\n<div class=\"sm-timing__item__time\" {{a:items.2.time}}>{{v:items.2.time}}</div>\n<div class=\"sm-timing__item__title\" {{a:items.2.title}}>{{v:items.2.title}}</div>\n</div>\n</div>\n<div class=\"sm-timing__item item-animation item-aleft\">\n<div class=\"sm-timing-text\">\n<div class=\"sm-timing__item__time\" {{a:items.3.time}}>{{v:items.3.time}}</div>\n<div class=\"sm-timing__item__title\" {{a:items.3.title}}>{{v:items.3.title}}</div>\n</div>\n</div>\n</div>\n</div>\n</section>"
    },
    {
      "type": "DRESSCODE",
      "tag": "",
      "html": "<section {{section:attrs}} class=\"sm-dress-code sm-section-type-1\">{{section:tools}}\n<div class=\"sm-container\">\n<h2 class=\"sm-title item-animation item-abottom\">\n<span {{a:title}}>{{v:title}}</span>\n<span></span>\n</h2>\n<p class=\"sm-text item-animation item-atop\" {{a:text}}>{{v:text}}</p>\n<div class=\"sm-dress-code__colors item-animation item-aleft wv-palette\">{{palette:colors}}</div>\n<div class=\"sm-dress-code__box-gallery\">\n<div class=\"sm-dress-code__box-gallery__item\">\n<div class=\"sm-dress-code__box-gallery__title\">Девушки</div>\n<div class=\"sm-dress-code__slider1 item-animation item-aright slick-slider\" data-carousel=\"\" data-slide=\"0\">\n<a class=\"sm-dress-code__slider__item\" href=\"javascript:void(0)\">\n<img alt=\"Фотография\" {{xi:Образы для девушек:items.0.imageUrl}} loading=\"lazy\" src=\"{{x:Образы для девушек:items.0.imageUrl}}\"/>\n</a><a class=\"sm-dress-code__slider__item\" href=\"javascript:void(0)\">\n<img alt=\"Фотография\" {{xi:Образы для девушек:items.1.imageUrl}} loading=\"lazy\" src=\"{{x:Образы для девушек:items.1.imageUrl}}\"/>\n</a><a class=\"sm-dress-code__slider__item\" href=\"javascript:void(0)\">\n<img alt=\"Фотография\" {{xi:Образы для девушек:items.2.imageUrl}} loading=\"lazy\" src=\"{{x:Образы для девушек:items.2.imageUrl}}\"/>\n</a>\n</div>\n<div class=\"sm-dress-code__arrows item-animation item-atop\">\n<div class=\"sm-dress-code__arrow sm-arrow sm-arrow-prev slick-arrow\" data-wv-prev=\"\" style=\"\">\n<img alt=\"\" src=\"/media/invite-priznanie/87c0ae4f-arrow.webp\"/>\n</div>\n<div class=\"sm-dress-code__arrow sm-arrow sm-arrow-next slick-arrow\" data-wv-next=\"\" style=\"\">\n<img alt=\"\" src=\"/media/invite-priznanie/87c0ae4f-arrow.webp\"/>\n</div>\n</div>\n</div>\n<div class=\"sm-dress-code__box-gallery__item\">\n<div class=\"sm-dress-code__box-gallery__title\">Мужчины</div>\n<div class=\"sm-dress-code__slider2 item-animation item-aleft slick-slider\" data-carousel=\"\" data-slide=\"0\">\n<a class=\"sm-dress-code__slider__item\" href=\"javascript:void(0)\">\n<img alt=\"Фотография\" {{xi:Образы для мужчин:items.0.imageUrl}} loading=\"lazy\" src=\"{{x:Образы для мужчин:items.0.imageUrl}}\"/>\n</a><a class=\"sm-dress-code__slider__item\" href=\"javascript:void(0)\">\n<img alt=\"Фотография\" {{xi:Образы для мужчин:items.1.imageUrl}} loading=\"lazy\" src=\"{{x:Образы для мужчин:items.1.imageUrl}}\"/>\n</a><a class=\"sm-dress-code__slider__item\" href=\"javascript:void(0)\">\n<img alt=\"Фотография\" {{xi:Образы для мужчин:items.2.imageUrl}} loading=\"lazy\" src=\"{{x:Образы для мужчин:items.2.imageUrl}}\"/>\n</a>\n</div>\n<div class=\"sm-dress-code__arrows item-animation item-atop\">\n<div class=\"sm-dress-code__arrow sm-arrow sm-arrow-prev slick-arrow\" data-wv-prev=\"\" style=\"\">\n<img alt=\"\" src=\"/media/invite-priznanie/87c0ae4f-arrow.webp\"/>\n</div>\n<div class=\"sm-dress-code__arrow sm-arrow sm-arrow-next slick-arrow\" data-wv-next=\"\" style=\"\">\n<img alt=\"\" src=\"/media/invite-priznanie/87c0ae4f-arrow.webp\"/>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>"
    },
    {
      "type": "COUNTDOWN",
      "tag": "",
      "html": "<section {{section:attrs}} class=\"sm-time sm-section-type-2\" data-wv-until=\"{{g:until}}\">{{section:tools}}\n<div class=\"sm-container\">\n<div class=\"sm-time__image item-animation item-aright\">\n<div class=\"sm-img\">\n<img alt=\"\" loading=\"lazy\" src=\"/media/invite-priznanie/e0ac5d21-timer.webp\"/>\n</div>\n</div>\n<h2 class=\"sm-title item-animation item-atop\" {{a:title}}>{{v:title}}</h2>\n<div class=\"sm-time__box item-animation item-abottom\">\n<div class=\"sm-time__item\">\n<div class=\"sm-time__item_number\" data-clock-digits=\"true\" data-clock-unit=\"days\" id=\"days\">{{clock:days}}</div>\n<p class=\"sm-time__item__title\" id=\"days-title\">\n                        Дней\n                    </p>\n</div>\n<div class=\"sm-time__item\" id=\"hours\">\n<div class=\"sm-time__item_number\" data-clock-digits=\"true\" data-clock-unit=\"hours\">{{clock:hours}}</div>\n<p class=\"sm-time__item__title\" id=\"hours-title\">\n                        Часа\n                    </p>\n</div>\n<div class=\"sm-time__item\" id=\"minutes\">\n<div class=\"sm-time__item_number\" data-clock-digits=\"true\" data-clock-unit=\"minutes\">{{clock:minutes}}</div>\n<p class=\"sm-time__item__title\" id=\"minutes-title\">\n                        Минут\n                    </p>\n</div>\n<div class=\"sm-time__item\" id=\"seconds\">\n<div class=\"sm-time__item_number\" data-clock-digits=\"true\" data-clock-unit=\"seconds\">{{clock:seconds}}</div>\n<p class=\"sm-time__item__title\" id=\"seconds-title\">\n                        Секунд\n                    </p>\n</div>\n</div>\n</div>\n</section>"
    },
    {
      "type": "TEXT",
      "tag": "Пожелания",
      "html": "<section {{section:attrs}} class=\"sm-wishes sm-section-type-1\">{{section:tools}}\n<div class=\"sm-container\">\n<h2 class=\"sm-title item-animation item-aleft\" {{a:title}}>{{v:title}}</h2>\n<div class=\"sm-slider sm-wishes__content-slider item-animation item-atop slick-slider\" data-carousel=\"\" data-slide=\"0\">\n<div class=\"sm-wishes__content-item\"><div class=\"sm-wishes__content-slide\" {{a:text}}>{{v:text}}</div></div><div class=\"sm-wishes__content-item\"><div class=\"sm-wishes__content-slide\" {{xa:Пожелание 2:text}}>{{x:Пожелание 2:text}}</div></div><div class=\"sm-wishes__content-item\"><div class=\"sm-wishes__content-slide\" {{xa:Пожелание 3:text}}>{{x:Пожелание 3:text}}</div></div></div>\n<div class=\"sm-wishes__pagination-wrapper\" id=\"wishes-navigation\">\n<div class=\"sm-arrow sm-arrow-prev slick-arrow\" data-wv-prev=\"\" style=\"\">\n<img alt=\"\" src=\"/media/invite-priznanie/87c0ae4f-arrow.webp\"/>\n</div>\n<div class=\"sm-wishes__pagination\">\n<span data-wv-counter=\"current\" id=\"current-slide\">1</span>\n<span>/</span>\n<span data-wv-total=\"\" id=\"count-slides\">3</span>\n</div>\n<div class=\"sm-arrow sm-arrow-next slick-arrow\" data-wv-next=\"\" style=\"\">\n<img alt=\"\" src=\"/media/invite-priznanie/87c0ae4f-arrow.webp\"/>\n</div>\n</div>\n</div>\n</section>"
    },
    {
      "type": "TEXT",
      "tag": "Контакты",
      "html": "<section {{section:attrs}} class=\"sm-contact sm-section-type-1\">{{section:tools}}\n<div class=\"sm-container\">\n<div class=\"sm-contact__box item-animation item-atop\">\n<h2 class=\"sm-title\">Контакты</h2>\n<p class=\"sm-text\" {{a:text}}>{{v:text}}</p>\n</div>\n<div class=\"sm-contact__info item-animation item-abottom\">\n<span {{a:title}}>{{v:title}}</span><br/>\n<a href=\"tel:{{tel:phone1:+7 (926) 888-77-88}}\">{{l:phone1:+7 (926) 888-77-88}}</a><br/>\n<a class=\"sm-btn\" href=\"tel:{{tel:phone1:+7 (926) 888-77-88}}\">{{l:contact:Связаться}}</a>\n</div>\n</div>\n</section>"
    },
    {
      "type": "RSVP_FORM",
      "tag": "",
      "html": "<section {{section:attrs}} class=\"sm-questionnaire sm-section-type-2 sm-modal\" id=\"rsvp\">{{section:tools}}\n<div class=\"sm-modal-close sm-quest-modal-close\">X</div>\n<div class=\"sm-container\">\n<div class=\"sm-questionnaire__head\">\n<div class=\"sm-title item-animation item-aleft\">\n<span {{a:title}}>{{v:title}}</span>\n<span></span>\n</div>\n<div class=\"sm-text item-animation item-atop\" {{a:text}}>{{v:text}}</div>\n<div class=\"sm-questionnaire__date\">\n<span class=\"sm-inline-animation item-animation item-aright\" data-wv-date=\"\">{{g:deadlineDay}}</span>.<span class=\"sm-inline-animation item-animation item-abottom\" data-wv-date=\"\">{{g:deadlineMonth}}</span>.<span class=\"sm-inline-animation item-animation item-aleft\" data-wv-date=\"\">{{g:fullYear}}</span>\n</div>\n</div>\n<div class=\"sm-questionnaire__form\">\n<form class=\"sm-form item-animation item-abottom\" data-wv-form=\"\" method=\"post\">{{form:body}}</form>\n</div>\n<a class=\"sm-btn sm-only-mobile open-modal item-animation item-abottom\">Подтвердить</a>\n</div>\n</section>"
    },
    {
      "type": "TEXT",
      "tag": "Окончание",
      "html": "<section {{section:attrs}} class=\"sm-footer sm-section sm-section-type-1\">{{section:tools}}\n<div class=\"sm-container\">\n<div class=\"sm-title\">\n<span class=\"sm-inline-animation item-animation item-atop\" {{a:title}}>{{v:title}}</span>\n<br/>\n<span class=\"sm-inline-animation item-animation item-abottom\">С любовью</span>\n</div>\n<div class=\"sm-footer__content\">\n<div class=\"sm-footer__images item-animation item-aright\">\n<div class=\"sm-footer__image\">\n<div class=\"sm-img\">\n<img alt=\"Фотография\" {{xi:Окончание · фотографии:items.0.imageUrl}} loading=\"lazy\" src=\"{{x:Окончание · фотографии:items.0.imageUrl}}\"/>\n</div>\n</div>\n<div class=\"sm-footer__image\">\n<div class=\"sm-img\">\n<img alt=\"Фотография\" {{xi:Окончание · фотографии:items.1.imageUrl}} loading=\"lazy\" src=\"{{x:Окончание · фотографии:items.1.imageUrl}}\"/>\n</div>\n</div>\n</div>\n<div class=\"sm-footer__names\">\n<div class=\"sm-needtoresize\">\n<span class=\"sm-inline-animation item-animation item-aleft\" data-wedding-names=\"\">{{g:groom}}</span>\n<br/>\n<span class=\"sm-inline-animation item-animation item-atop\">&amp;</span>\n<span class=\"sm-inline-animation item-animation item-aright\" data-wedding-names=\"\">{{g:bride}}</span>\n</div>\n</div>\n</div>\n</div>\n</section>"
    }
  ]
}