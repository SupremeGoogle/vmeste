      "html": "<section {{section:attrs}} class=\"sm-form\" id=\"rsvp\">{{section:tools}}\n<div class=\"sm-container\">\n<div class=\"sm-form__inner\">\n<div class=\"sm-form__bt\">\n<a class=\"sm-button\" href=\"#\">Подтвердить присутствие</a>\n</div>\n<div class=\"sm-form__l text-paint-background-after\">\n<div class=\"sm-form__numb background-paint-background\">\n<span class=\"item-animation item-aright\" data-wv-date=\"\">{{g:deadlineDay}}</span>\n<span class=\"item-animation item-atop\" data-wv-date=\"\">{{g:deadlineMonth}}</span>\n<span class=\"item-animation item-aleft\" data-wv-date=\"\">{{g:deadlineYear}}</span>\n</div>\n</div>\n<div class=\"sm-form__r\">\n<h2 class=\"item-animation item-aleft\"><i {{a:title}}>{{v:title}}</i><div class=\"span\"><span class=\"sm-needtoresize text-no-paint\">Вас</span></div></h2>\n<div class=\"sm-form__tx item-animation item-atop\">\n<p {{a:text}}>{{v:text}}</p>\n</div>\n<div class=\"sm-form__al item-animation item-atop\">\n<form data-wv-form=\"\" method=\"post\">{{form:body}}</form>\n</div>\n</div>\n</div>\n</div>\n</section>"
    },
    {
      "type": "TEXT",
      "tag": "Окончание",
      "html": "<section {{section:attrs}} class=\"sm-footer\">{{section:tools}}\n<div class=\"sm-footer__bg\" style=\"\">\n<img alt=\"\" class=\"transition\" src=\"/media/invite-odnazhdy/afef3446-footer-bg.svg\" style=\"\"/>\n</div>\n<div class=\"sm-container\">\n<div class=\"sm-footer__inner\">\n<h2 class=\"item-animation item-abottom\" {{a:title}}>{{v:title}}</h2>\n<div class=\"sm-footer__tx\">\n<div class=\"sm-footer__tx-l item-animation item-aleft\"><span class=\"nstyle\">With Love</span></div>\n<div class=\"sm-footer__tx-r item-animation item-aright\">\n<i class=\"nstyle\" data-wedding-names=\"\">{{g:groom}}</i> и<br/>\n<span><i class=\"nstyle\" data-wedding-names=\"\">{{g:bride}}</i></span>\n</div>\n</div>\n</div>\n</div>\n</section>"
    }
  ]
