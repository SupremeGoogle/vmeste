      "type": "COUNTDOWN",
      "tag": "",
      "html": "<section {{section:attrs}} class=\"sm-tmr\" data-wv-until=\"{{g:until}}\">{{section:tools}}\n<div class=\"sm-container\">\n<div class=\"sm-tmr__inner\">\n<h2><span class=\"nstyle item-animation item-atop\" {{a:title}}>{{v:title}}</span></h2>\n<div class=\"sm-tmr__timer item-animation item-abottom\" data-wv-countdown=\"\">\n<div class=\"sm-tmr__timer-bg\">\n<img alt=\"\" class=\"transition\" src=\"/media/invite-odnazhdy/a0182544-tmr-bg.png\" style=\"\"/>\n</div>\n<div class=\"sm-tmr__timer-list sm-timer\">\n<div class=\"sm-tmr__timer-list-it\">\n<div class=\"sm-tmr__timer-list-numb\" data-clock-digits=\"false\" data-clock-unit=\"days\" id=\"sm-days\">{{clock:days}}</div>\n<div class=\"sm-tmr__timer-list-tx\">Дней</div>\n</div>\n<div class=\"sm-tmr__timer-list-it\">\n<div class=\"sm-tmr__timer-list-numb\" data-clock-digits=\"false\" data-clock-unit=\"hours\" id=\"sm-hours\">{{clock:hours}}</div>\n<div class=\"sm-tmr__timer-list-tx\">Часов</div>\n</div>\n<div class=\"sm-tmr__timer-list-it\">\n<div class=\"sm-tmr__timer-list-numb\" data-clock-digits=\"false\" data-clock-unit=\"minutes\" id=\"sm-minutes\">{{clock:minutes}}</div>\n<div class=\"sm-tmr__timer-list-tx\">Минут</div>\n</div>\n<div class=\"sm-tmr__timer-list-it\">\n<div class=\"sm-tmr__timer-list-numb\" data-clock-digits=\"false\" data-clock-unit=\"seconds\" id=\"sm-seconds\">{{clock:seconds}}</div>\n<div class=\"sm-tmr__timer-list-tx\">Секунд</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>"
