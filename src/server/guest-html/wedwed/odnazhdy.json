      "html": "<section {{section:attrs}} class=\"sm-code\">{{section:tools}}\n<div class=\"sm-container\">\n<div class=\"sm-code__inner\">\n<h2 class=\"item-animation item-abottom\"><span class=\"nstyle\" {{a:title}}>{{v:title}}</span></h2>\n<div class=\"sm-code__tx item-animation item-atop\">\n<p><span class=\"nstyle\" {{a:text}}>{{v:text}}</span></p>\n</div>\n<div class=\"sm-code__colors\">\n<div class=\"sm-code__colors-title item-animation item-aright\">Attire</div>\n<div class=\"sm-code__colors-list item-animation item-aleft wv-palette\">{{palette:colors}}</div>\n</div>\n<div class=\"sm-code__sliders\">\n<div class=\"sm-code__sliders-it item-animation item-aright\">\n<div class=\"sm-code__sliders-title\"><span class=\"nstyle\">Для девушек</span></div>\n<div class=\"sm-code__slider js-sm-code-sliderOn slick-slider\" data-carousel=\"\" data-slide=\"0\">\n<div class=\"sm-code__slider-al\">\n<a href=\"javascript:void(0)\">\n<img alt=\"Фотография\" {{xi:Образы для девушек:items.0.imageUrl}} loading=\"lazy\" src=\"{{x:Образы для девушек:items.0.imageUrl}}\"/>\n</a>\n</div><div class=\"sm-code__slider-al\">\n<a href=\"javascript:void(0)\">\n<img alt=\"Фотография\" {{xi:Образы для девушек:items.1.imageUrl}} loading=\"lazy\" src=\"{{x:Образы для девушек:items.1.imageUrl}}\"/>\n</a>\n</div><div class=\"sm-code__slider-al\">\n<a href=\"javascript:void(0)\">\n<img alt=\"Фотография\" {{xi:Образы для девушек:items.2.imageUrl}} loading=\"lazy\" src=\"{{x:Образы для девушек:items.2.imageUrl}}\"/>\n</a>\n</div><div class=\"sm-code__slider-al\">\n<a href=\"javascript:void(0)\">\n<img alt=\"Фотография\" {{xi:Образы для девушек:items.3.imageUrl}} loading=\"lazy\" src=\"{{x:Образы для девушек:items.3.imageUrl}}\"/>\n</a>\n</div>\n</div>\n<div class=\"sm-slider-pagination sm-slider-paginationOn\">\n<div class=\"sm-slider-arrows sm-slider-arrowsOn\"><div class=\"sm-slider__arrow sm-slider__arrow_left slick-arrow\" data-wv-prev=\"\" style=\"\"></div><div class=\"sm-slider__arrow sm-sl