b75eb-time-ic3.svg\" style=\"\"/>\n</div>\n<div class=\"sm-time__list-r\">\n<div class=\"sm-time__list-wr text-paint-border item-animation item-abottom\">\n<span>We Party</span>\n</div>\n<div class=\"sm-time__list-all item-animation item-atop\"><span class=\"nstyle\" {{a:items.2.title}}>{{v:items.2.title}}</span></div>\n</div>\n</div>\n</div>\n<div class=\"sm-time__list-row\">\n<div class=\"sm-time__list-tm item-animation item-aright\"><span class=\"nstyle\" {{a:items.3.time}}>{{v:items.3.time}}</span></div>\n<div class=\"sm-time__list-hl\">\n<div class=\"sm-time__list-icon item-animation item-aleft\">\n<img alt=\"\" class=\"transition\" src=\"/media/invite-odnazhdy/e6ceff0b-time-ic4.svg\" style=\"\"/>\n</div>\n<div class=\"sm-time__list-r\">\n<div class=\"sm-time__list-wr text-paint-border item-animation item-abottom\">\n<span>The End</span>\n</div>\n<div class=\"sm-time__list-all item-animation item-atop\"><span class=\"nstyle\" {{a:items.3.title}}>{{v:items.3.title}}</span></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>"
