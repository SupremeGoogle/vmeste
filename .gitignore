# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env
.env
.env*.local

# ...но образец без ключей обязан лежать в git: без него после
# переустановки неоткуда узнать список переменных.
!.env.example

# Prisma (генерируется)
src/generated/

# Локальный dev-тулчейн (portable Node/PostgreSQL + данные базы) —
# ставится и пересоздаётся скриптом восстановления, в git не нужен.
/.localtools/

# Тестовые ролики и фото людей — не для репозитория
/videos/

# Черновики дизайна и временные файлы
/tmp/
/output/
# Личные заметки владельца — репозиторий публичный
/founder/
# Исходники картинок и черновики маскота: сайт их не использует
/public/media/landing-story/source/
/public/media/mascot-designs/
/public/media/mascot-concepts/
# Промо-ролик (скилл brag) — результат, а не исходники сайта
/brag-output/
# Установленные скиллы агентов (видео и т. п.) — не код сайта
/.agents/
/.claude/skills/
/.claude/founder-shared/
