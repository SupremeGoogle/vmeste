# Образец окружения. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
#
# Настоящий .env в git не попадает — там ключи. Этот файл нужен, чтобы
# после переустановки было видно, без каких переменных сервис не поднимется.

# ── База ────────────────────────────────────────────────────────────
# Порт 5433 — это встроенный кластер из .localtools (см. scripts/restore-dev.ps1).
# Системный PostgreSQL обычно занимает 5432, поэтому порты разведены.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/vmeste_dev"
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5433/vmeste_test"

# ── Адрес приложения ────────────────────────────────────────────────
# Попадает в QR-коды и именные ссылки гостей. Хардкода хоста в коде нет,
# поэтому в проде здесь обязан быть внешний адрес, а не localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Снимает флаг Secure с cookie — только для локальной сети без HTTPS
# (план Б в зале, PLAN.md §5.1). В проде переменную не задавать.
COOKIE_SECURE="false"

# ── Хранилище фотографий (S3-совместимое: MinIO локально) ───────────
S3_ENDPOINT="http://127.0.0.1:9000"
# Внешний адрес хранилища для подписанных ссылок загрузки (телефон гостя
# кладёт фото прямо туда). На сервере: https://s3.<домен>; локально не нужен.
# S3_PUBLIC_ENDPOINT="https://s3.example.ru"
S3_REGION="us-east-1"
S3_BUCKET="vmeste-dev"
S3_ACCESS_KEY="localdev"
S3_SECRET_KEY="localdevsecret"

# ── Вход через Google (необязательно) ───────────────────────────────
# Без этих двух ключей кнопка «Войти через Google» просто не показывается
# (см. googleEnabled() в src/server/auth/google.ts) — вход по паролю работает.
# Redirect URI в консоли Google: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Умный разбор списка гостей при загрузке Excel (раздел «Гости»).
# Без ключа импорт работает правилами, переключателя «Умный разбор» нет.
# Имена гостей уходят в DeepSeek, телефоны и почты заменяются метками.
DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL="deepseek-flash"

# ── Панель суперадмина (/admin) ─────────────────────────────────
# Владелец платформы: почта Google, через запятую. Права владельца
# выдаются только этой почте и только при входе через Google.
SUPERADMIN_EMAILS="akbarchik0071@gmail.com"
# Сроки хранения: свадьба уходит в архив через 10 дней после даты, фото
# удаляются через 15. Не действуют для свадеб, где владелец — почта из
# SUPERADMIN_EMAILS или отсюда (через запятую). RETENTION_DISABLED=1 — выключить.
RETENTION_EXEMPT_EMAILS="1@1"
# Ключ шифрования секретов 2FA, не короче 32 символов. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Сменили ключ — всем администраторам придётся заново настроить 2FA
# (сброс: npm run admin:reset-2fa -- почта).
ADMIN_SECRET=""

# ── Ошибки и падения: Sentry (sentry.io) ────────────────────────
# DSN проекта: Settings → Projects → Client Keys. Без него Sentry выключен.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
# Для загрузки карт кода при сборке (понятные стеки ошибок). Необязательно.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Запись экрана при ошибке в панели организатора (1 — включить).
NEXT_PUBLIC_SENTRY_REPLAY="0"

# ── Веб-аналитика: Rybbit (github.com/rybbit-io/rybbit) ─────────
# Облако: https://app.rybbit.io, или свой сервер (нужно от 2 ГБ памяти).
NEXT_PUBLIC_RYBBIT_HOST=""
NEXT_PUBLIC_RYBBIT_SITE_ID=""
# Ключ API — для цифр посещаемости в панели суперадмина.
RYBBIT_API_KEY=""

# ── Уведомления владельцу в Telegram ────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Сервер в России не достучится до api.telegram.org — сюда адрес прокси
# (Cloudflare Worker / туннель), пересылающего запросы в Telegram.
TELEGRAM_API_BASE=""

# ── Письма (регистрация по почте, сброс пароля) ───────────────
# Resend: https://resend.com → API Keys. Домен отправителя подтверждается
# в Resend → Domains записями DNS. Пока ключа нет — форма регистрации по
# почте скрыта, а локально письма печатаются в лог сервера.
RESEND_API_KEY=""
EMAIL_FROM="Вместе <hello@vvvmeste.com>"
# Куда уходят ответы на письма (необязательно)
EMAIL_REPLY_TO=""
