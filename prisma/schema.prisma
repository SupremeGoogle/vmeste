// Схема данных сервиса. Комментарии к решениям — в PLAN.md §1.
// Правило мультиарендности: каждая дочерняя сущность ссылается на родителя
// парой (eventId, id), а не одним id. Это делает кросс-арендную связь
// невозможной на уровне БД, а не на уровне внимательности разработчика.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, citext, pgcrypto]
}

// ────────────────────────────────────────────────────────────
// Организация и пользователи
// ────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Membership[]
  events  Event[]

  @@map("organizations")
}

model User {
  id String @id @default(cuid())

  email         String   @unique @db.Citext
  // Пароля может не быть вовсе: у пришедшего через Google его никогда не
  // было, и придумывать ему случайный хеш — значит завести в базе строку,
  // которой никто не сможет воспользоваться, но которая выглядит как пароль.
  passwordHash  String?
  name          String
  // Подтверждена ли почта. Google подтверждает её за нас, при регистрации по
  // почте — ссылка из письма (EmailToken). Без подтверждения вход по паролю
  // закрыт: иначе любой занял бы чужой адрес раньше хозяина.
  emailVerified Boolean  @default(false)
  // Аватар из профиля Google: единственная картинка, которую мы не рисуем сами.
  avatarUrl     String?
  createdAt     DateTime @default(now())

  // Права на всю платформу (панель /admin). Владелец платформы задаётся
  // почтой в SUPERADMIN_EMAILS и здесь не хранится: его нельзя разжаловать
  // из интерфейса, даже взломав другую учётку с правами ADMIN.
  platformRole  PlatformRole?
  // Заблокирован суперадмином: войти нельзя, все сессии погашены.
  blockedAt     DateTime?
  blockedReason String?

  memberships Membership[]
  sessions    Session[]
  accounts    OAuthAccount[]
  adminSecret AdminSecret?
  emailTokens EmailToken[]

  @@map("users")
}

/// Права на всю платформу, выданные владельцем.
enum PlatformRole {
  /// Управляет пользователями и мероприятиями, но не другими администраторами.
  ADMIN
  /// Только смотрит: статистика, пользователи, мероприятия, журнал.
  SUPPORT
}

/// Второй фактор для панели суперадмина: TOTP (Google Authenticator и т. п.).
///
/// Секрет хранится зашифрованным ключом из ADMIN_SECRET: утечка одной базы
/// не даёт коды. Резервные коды — только хешами, каждый одноразовый.
model AdminSecret {
  userId       String    @id
  totpSecret   String
  confirmedAt  DateTime?
  /// Последний принятый 30-секундный шаг: один код дважды не проходит.
  lastStep     Int       @default(0)
  backupCodes  String[]
  failedCount  Int       @default(0)
  lockedUntil  DateTime?
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_secrets")
}

/// Журнал панели суперадмина: кто, что и с кем сделал. Только дописывается.
model AdminAudit {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  action     String
  targetType String?
  targetId   String?
  detail     Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit")
}

/// Вход через внешнего поставщика (пока только Google).
///
/// Отдельная таблица, а не колонка `googleId` в `users`: завтра появится
/// второй поставщик, и переписывать схему на живой базе ради этого не
/// хочется. Пара «поставщик + его идентификатор» уникальна — она и есть
/// ключ, по которому мы узнаём вернувшегося человека. Почта для этого не
/// годится: её в Google можно сменить, а `sub` неизменен.
model OAuthAccount {
  id String @id @default(cuid())

  userId   String
  provider AuthProvider

  /// `sub` из id_token — вечный идентификатор человека у поставщика.
  providerAccountId String
  /// Почта на момент привязки: нужна только для журнала и поддержки.
  email             String @db.Citext

  createdAt DateTime @default(now())
  lastLogin DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

enum AuthProvider {
  GOOGLE
}

/// Резерв хранится отдельно: уникальность giftId защищает от двух
/// одновременных нажатий, удаление гостя освобождает подарок.
model Gift {
  id          String @id @default(cuid())
  orgId       String
  eventId     String
  title       String
  description String @default("")
  url         String @default("")
  /// Картинка пункта виш-листа: адрес загруженной организатором картинки
  /// (`/api/asset/<eventId>/<id>`). Пусто — без картинки.
  imageUrl    String @default("")
  createdAt   DateTime @default(now())
  event       Event @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)
  reservation GiftReservation?
  @@unique([eventId, id])
  @@index([eventId, createdAt])
  @@map("gifts")
}

model GiftReservation {
  id        String @id @default(cuid())
  orgId     String
  eventId   String
  giftId    String @unique
  guestId   String
  createdAt DateTime @default(now())
  event     Event @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)
  gift      Gift @relation(fields: [eventId, giftId], references: [eventId, id], onDelete: Cascade)
  guest     Guest @relation(fields: [eventId, guestId], references: [eventId, id], onDelete: Cascade)
  @@unique([eventId, giftId])
  @@index([eventId, guestId])
  @@map("gift_reservations")
}

enum DayStepAction {
  NONE
  SCREEN_PHOTOS
  SCREEN_WISHES
  SCREEN_MIXED
  RAFFLE
}

enum DayStepStatus {
  PENDING
  RUNNING
  DONE
}

model DayStep {
  id              String @id @default(cuid())
  orgId           String
  eventId         String
  title           String
  responsible     String @default("")
  notes           String @default("")
  startsAt        DateTime
  reminderMinutes Int @default(10)
  action          DayStepAction @default(NONE)
  raffleId        String?
  status          DayStepStatus @default(PENDING)
  completedAt     DateTime?
  runStartedAt    DateTime?
  event           Event @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)
  @@index([eventId, startsAt])
  @@map("day_steps")
}

enum OrgRole {
  OWNER
  PLANNER
  STAFF
}

model Membership {
  id     String  @id @default(cuid())
  orgId  String
  userId String
  role   OrgRole @default(PLANNER)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Одноразовая ссылка из письма: подтверждение почты или сброс пароля.
/// В базе — только SHA-256 токена: утечка таблицы не даёт рабочих ссылок.
model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  /// Адрес, на который ушло письмо: сменилась почта — старая ссылка не годится.
  email     String            @db.Citext
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

enum EmailTokenPurpose {
  VERIFY
  RESET
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Откуда вошли — для списка сессий в панели суперадмина.
  ip        String?
  userAgent String?
  // До какого момента этой сессии открыта панель /admin (после кода 2FA).
  adminUntil     DateTime?
  // Сессия «войти как пользователь»: кто из администраторов в ней сидит.
  impersonatorId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ────────────────────────────────────────────────────────────
// Мероприятие
// ────────────────────────────────────────────────────────────

/**
 * Что показывает экран в зале прямо сейчас. Переключает организатор
 * из панели; экран узнаёт об этом из потока событий, не перезагружаясь.
 */
enum ScreenMode {
  PHOTOS
  WISHES
  MIXED
  RAFFLE
  IDLE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Event {
  id        String      @id @default(cuid())
  orgId     String
  title     String
  slug      String
  shortCode String
  status    EventStatus @default(DRAFT)

  eventDate DateTime
  timezone  String   @default("Europe/Moscow")
  venueName String?
  venueAddr String?
  venueLat  Float?
  venueLng  Float?

  rsvpDeadline       DateTime?
  allowPlusOne       Boolean    @default(true)
  photoLimitPerGuest Int        @default(5)
  photosEnabled      Boolean    @default(true)
  wishesEnabled      Boolean    @default(true)
  raffleEnabled      Boolean    @default(true)
  screenMode         ScreenMode @default(MIXED)
  giftsEnabled       Boolean    @default(false)
  giftTransferLabel  String     @default("Подарок в конверте")
  giftTransferDetails String    @default("")
  giftTransferUrl    String     @default("")
  albumEnabled       Boolean    @default(true)
  teamPlanToken      String?    @unique
  activeRaffleId     String?

  // Секрет для подписи гостевых cookie. Ротация обнуляет все гостевые сессии.
  /// Оформление приглашения: шаблон и его настройки. JSON, а не колонки,
  /// потому что набор осей будет меняться чаще, чем хочется писать
  /// миграции, а читается он всегда целиком и терпимо (`invite-theme.ts`).
  inviteTheme Json @default("{}")
  printDesign Json @default("{}")

  guestLinkSecret String @default(dbgenerated("encode(gen_random_bytes(32), 'hex')"))

  // Версия рассадки: растёт при каждой операции, ловит одновременное
  // редактирование в двух вкладках (PLAN.md §5.4).
  seatingVersion Int @default(0)

  // Размер зала в условных единицах плана. Организатор растягивает зал
  // мышью; 1000×700 — прежний фиксированный размер, чтобы старые планы
  // остались на своих местах.
  hallWidth  Float @default(1000)
  hallHeight Float @default(700)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  blocks        InviteBlock[]
  assets        EventAsset[]
  guests        Guest[]
  mealOptions   MealOption[]
  drinkOptions  DrinkOption[]
  tables        SeatTable[]
  seats         Seat[]
  photos        Photo[]
  wishes        Wish[]
  raffles       Raffle[]
  screens       ScreenToken[]
  rsvpQuestions RsvpQuestion[]
  gifts         Gift[]
  giftReservations GiftReservation[]
  daySteps      DayStep[]

  @@unique([orgId, id])
  @@unique([orgId, slug])
  @@unique([shortCode])
  @@index([orgId, status])
  @@map("events")
}

// ────────────────────────────────────────────────────────────
// Конструктор приглашения
// ────────────────────────────────────────────────────────────

enum BlockType {
  COUNTDOWN
  COVER
  TIMELINE
  VENUE
  DRESSCODE
  MAP
  TEXT
  RSVP_FORM
  PHOTOS
  CALENDAR
  WISHLIST
}

/// Картинка, загруженная организатором: обложка приглашения, фон, снимок
/// пары. Отдельно от `Photo` намеренно: у гостевых фотографий есть
/// модерация, лимиты и массовое удаление, а обложка живёт, пока живёт
/// свадьба, и никакой очереди не проходит.
model EventAsset {
  id      String @id @default(cuid())
  orgId   String
  eventId String

  storageKey  String
  contentType String
  bytes       Int
  /// Подпись для доступности: её пишет организатор, а показывает браузер
  /// гостя, у которого не загрузилась картинка.
  alt         String @default("")

  createdAt DateTime @default(now())

  event Event @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_assets")
}

model InviteBlock {
  id      String    @id @default(cuid())
  orgId   String
  eventId String
  type    BlockType
  order   Int
  visible Boolean   @default(true)
  content Json      @default("{}")

  event Event @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)

  @@unique([eventId, order])
  @@index([eventId])
  @@map("invite_blocks")
}

// ВАЖНО про onDelete: составной внешний ключ (eventId, xId) нельзя объявить
// как SetNull — Postgres обнулил бы обе колонки, включая NOT NULL eventId,
// и удаление падало бы в рантайме. Поэтому такие связи объявлены как Restrict,
// а отвязка делается явно в репозитории (guests.archive / guests.remove):
// сначала обнуляем ссылку, потом удаляем строку.

// ────────────────────────────────────────────────────────────
// Гости
// ────────────────────────────────────────────────────────────

/**
 * Роль на свадьбе. Нужна ровно для одного: показать на плане зала, где
 * сидят молодожёны, — это первый вопрос гостя, который вошёл в зал.
 * Ролей может быть по две одинаковых: свадьбы бывают разные, и схема
 * не должна этому мешать.
 */
enum GuestRole {
  GUEST
  BRIDE
  GROOM
}

enum RsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Тип поля анкеты RSVP. MEAL и DRINKS — «кто что ест» и «кто что пьёт»:
/// их варианты — блюда и напитки мероприятия (MealOption / DrinkOption),
/// а ответы ложатся в Guest.mealOptionId и GuestDrink, как и раньше.
enum RsvpQuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  DROPDOWN
  RATING
  DATE
  MEAL
  DRINKS
  MUSIC
}

/// Поле анкеты RSVP в приглашении — конструктор «как в Google Формах».
/// Нет ни одной строки — анкета как раньше: блюдо и напитки, если заданы.
/// Меню (MEAL) и бар (DRINKS) — не больше одного на мероприятие: это держит
/// частичный уникальный индекс в миграции rsvp_singleton_questions.
model RsvpQuestion {
  id      String @id @default(cuid())
  orgId   String
  eventId String

  type        RsvpQuestionType @default(SHORT_TEXT)
  title       String
  description String           @default("")
  required    Boolean          @default(false)
  /// Варианты для SINGLE_CHOICE / MULTIPLE_CHOICE / DROPDOWN — массив строк.
  options     Json             @default("[]")
  order       Int

  event Event @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)

  @@unique([eventId, id])
  @@index([eventId, order])
  @@map("rsvp_questions")
}

model MealOption {
  id      String  @id @default(cuid())
  orgId   String
  eventId String
  title   String
  order   Int
  active  Boolean @default(true)

  event  Event   @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)
  guests Guest[]

  @@unique([eventId, id])
  @@index([eventId])
  @@map("meal_options")
}

/// Напиток в баре. Устроен как блюдо: не удаляется, а выключается.
model DrinkOption {
  id      String  @id @default(cuid())
  orgId   String
  eventId String
  title   String
  order   Int
  active  Boolean @default(true)

  event   Event        @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)
  choices GuestDrink[]

  @@unique([eventId, id])
  @@index([eventId])
  @@map("drink_options")
}

/// Что гость будет пить. В отличие от блюда, напитков можно отметить
/// несколько: вино за ужином и шампанское на тост — обычное дело.
model GuestDrink {
  orgId         String
  eventId       String
  guestId       String
  drinkOptionId String

  guest Guest       @relation(fields: [eventId, guestId], references: [eventId, id], onDelete: Cascade)
  drink DrinkOption @relation(fields: [eventId, drinkOptionId], references: [eventId, id], onDelete: Restrict)

  @@id([guestId, drinkOptionId])
  @@index([eventId, drinkOptionId])
  @@map("guest_drinks")
}

model Guest {
  id      String @id @default(cuid())
  orgId   String
  eventId String

  displayName String
  role        GuestRole @default(GUEST)
  // Нормализованный ключ поиска: lower + ё→е + латиница→кириллица + без пунктуации.
  // Заполняется приложением (см. src/lib/name-normalize.ts).
  searchKey   String
  phone       String?
  email       String?
  note        String?

  linkToken    String    @unique
  linkOpenedAt DateTime?

  rsvpStatus     RsvpStatus @default(PENDING)
  rsvpAt         DateTime?
  mealOptionId   String?
  plusOneAllowed Boolean    @default(false)
  plusOneName    String?
  comment        String?
  // «Какую музыку предпочитаете?» из анкеты шаблона «Тили-тесто».
  musicWish      String?
  /// Ответы на вопросы анкеты RSVP из конструктора — снимком вместе с
  /// текстом вопроса: [{ questionId, title, type, value }]. Переименование
  /// или удаление вопроса старые ответы не портит.
  rsvpAnswers    Json       @default("[]")
  // Каким импортом из файла создан гость: по нему импорт можно отменить
  // в первые минуты, пока гостям ещё не разослали ссылки.
  importBatchId  String?
  /// Гость вписал себя сам по общей ссылке на приглашение, а не был
  /// заведён организатором: в списке он помечен, чтобы его было видно.
  selfRegistered Boolean   @default(false)

  // Спутник (+1) ссылается на «родителя». Он же связывает семью:
  // поиск на входе возвращает всю группу, см. PLAN.md §7 вопрос 1.
  parentGuestId String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  event         Event         @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)
  mealOption    MealOption?   @relation(fields: [eventId, mealOptionId], references: [eventId, id], onDelete: Restrict)
  parentGuest   Guest?        @relation("PlusOne", fields: [eventId, parentGuestId], references: [eventId, id], onDelete: Restrict)
  plusOnes      Guest[]       @relation("PlusOne")
  seat          Seat?
  photos        Photo[]
  wishes        Wish[]
  aliases       GuestAlias[]
  drinks        GuestDrink[]
  raffleEntries RaffleEntry[]
  giftReservations GiftReservation[]

  @@unique([eventId, id])
  @@index([eventId, importBatchId])
  @@index([eventId, rsvpStatus])
  @@index([eventId, searchKey])
  // Триграммный индекс: поиск гостя по имени с опечатками (PLAN.md §1.4)
  @@index([searchKey(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("guests")
}

// Дополнительные написания имени: «Настя», девичья фамилия, «мама Лена».
model GuestAlias {
  id      String @id @default(cuid())
  orgId   String
  eventId String
  guestId String
  alias   String
  source  String @default("auto") // auto | manual

  guest Guest @relation(fields: [eventId, guestId], references: [eventId, id], onDelete: Cascade)

  @@unique([guestId, alias])
  @@index([eventId, alias])
  @@index([alias(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("guest_aliases")
}

// ────────────────────────────────────────────────────────────
// Рассадка
// ────────────────────────────────────────────────────────────

enum TableShape {
  ROUND
  RECT
  OVAL
  HEAD
}

model SeatTable {
  id       String     @id @default(cuid())
  orgId    String
  eventId  String
  label    String
  shape    TableShape @default(ROUND)
  // Координаты в условных единицах плана 1000×700 (PLAN.md §4.7), не в пикселях.
  x        Float
  y        Float
  rotation Float      @default(0)
  width    Float      @default(120)
  height   Float      @default(120)
  capacity Int        @default(8)
  // Стол молодожёнов: места в один ряд лицом к залу, пара — в центре.
  // Один на мероприятие — это держит частичный уникальный индекс в миграции.
  isCouple Boolean    @default(false)

  event Event  @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)
  seats Seat[]

  @@unique([eventId, id])
  @@unique([eventId, label])
  @@index([eventId])
  @@map("seat_tables")
}

model Seat {
  id      String @id @default(cuid())
  orgId   String
  eventId String
  tableId String
  index   Int
  x       Float?
  y       Float?

  guestId String? @unique

  table SeatTable @relation(fields: [eventId, tableId], references: [eventId, id], onDelete: Cascade)
  guest Guest?    @relation(fields: [eventId, guestId], references: [eventId, id], onDelete: Restrict)
  event Event     @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)

  @@unique([tableId, index])
  @@unique([eventId, guestId])
  @@index([eventId])
  @@map("seats")
}

// ────────────────────────────────────────────────────────────
// Фото, пожелания, розыгрыш
// ────────────────────────────────────────────────────────────

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Photo {
  id      String  @id @default(cuid())
  orgId   String
  eventId String
  guestId String?

  storageKey  String
  thumbKey    String
  width       Int
  height      Int
  bytes       Int
  status      ModerationStatus @default(PENDING)
  moderatedAt DateTime?
  moderatedBy String?
  caption     String?

  // Превью делает браузер гостя (PLAN.md §4.4), и с ним бывает не судьба:
  // старый телефон не умеет декодировать HEIC в canvas. Такое фото
  // принимаем — потерять единственный кадр хуже, — но помечаем: в модерации
  // видно «превью не получилось», а на экран в зале оно не идёт (§5.5).
  previewOk Boolean @default(true)

  /// Оценка «18+» от NSFWJS, 0…1 (`server/images/nsfw.ts`). Пусто — фото
  /// загружено до фильтра или классификатор не ответил. Это подсказка
  /// модератору: высокая оценка размывает кадр в очереди, но не отклоняет.
  nsfwScore Float?

  createdAt DateTime @default(now())

  event Event  @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)
  guest Guest? @relation(fields: [eventId, guestId], references: [eventId, id], onDelete: Restrict)

  @@index([eventId, status, createdAt])
  @@index([eventId, guestId])
  @@map("photos")
}

model Wish {
  id      String  @id @default(cuid())
  orgId   String
  eventId String
  guestId String?

  authorName String
  text       String           @db.VarChar(500)
  status     ModerationStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  event Event  @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)
  guest Guest? @relation(fields: [eventId, guestId], references: [eventId, id], onDelete: Restrict)

  @@index([eventId, status, createdAt])
  @@map("wishes")
}

model Raffle {
  id      String @id @default(cuid())
  orgId   String
  eventId String
  title   String @default("Розыгрыш")

  // Фиксируется при запуске: позволяет повторить розыгрыш и доказать честность.
  seed          String?
  drawnAt       DateTime?
  winnerGuestId String?
  winnerLabel   String?

  createdAt DateTime @default(now())

  event   Event         @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)
  entries RaffleEntry[]

  @@unique([eventId, id])
  @@index([eventId])
  @@map("raffles")
}

model RaffleEntry {
  id       String @id @default(cuid())
  orgId    String
  eventId  String
  raffleId String
  guestId  String
  label    String

  raffle Raffle @relation(fields: [eventId, raffleId], references: [eventId, id], onDelete: Cascade)
  guest  Guest  @relation(fields: [eventId, guestId], references: [eventId, id], onDelete: Cascade)

  @@unique([raffleId, guestId])
  @@index([eventId])
  @@map("raffle_entries")
}

// ────────────────────────────────────────────────────────────
// Экран в зале и журнал
// ────────────────────────────────────────────────────────────

model ScreenToken {
  id         String    @id @default(cuid())
  orgId      String
  eventId    String
  token      String    @unique
  label      String    @default("Проектор")
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  event Event @relation(fields: [orgId, eventId], references: [orgId, id], onDelete: Cascade)

  @@index([eventId])
  @@map("screen_tokens")
}

model GuestActionLog {
  id        String   @id @default(cuid())
  orgId     String
  eventId   String
  guestId   String?
  action    String
  detail    String?
  ipHash    String?
  ua        String?
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([eventId, action, createdAt])
  @@map("guest_action_log")
}
